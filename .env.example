# ==============================================================================
# NextAuth v5 & Google OAuth Configuration
# ==============================================================================

# NextAuth v5 암호화 시크릿 키 (임의의 32자 이상 난수 문자열)
# PowerShell에서 생성: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
AUTH_SECRET="your-random-nextauth-secret-key-at-least-32-chars"

# Google Cloud Console > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID
AUTH_GOOGLE_ID="your-client-id.apps.googleusercontent.com"

# Google Cloud Console > 사용자 인증 정보 > 클라이언트 보안 비밀번호
AUTH_GOOGLE_SECRET="GOCSPX-your-client-secret"

# 프로덕션 배포 시 필수 (Vercel 배포 시 해당 프로덕션 도메인 입력)
NEXTAUTH_URL="http://localhost:3000"
